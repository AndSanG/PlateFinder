# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

APP_SCHEME = "PlateFinder"
APP_PROJECT = "PlateFinder.xcodeproj"
EXPORT_METHOD = "app-store"

default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if is_ci
  end

  desc "Load App Store Connect API Key"
  lane :load_asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY"],
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Fetch and increment build number"
  lane :fetch_and_increment_build_number do
    app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    api_key = lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]

    current_version = get_version_number(
      project: APP_PROJECT,
      target: APP_SCHEME
    )

    latest_build_number = latest_testflight_build_number(
      api_key: api_key,
      version: current_version,
      app_identifier: app_identifier
    )

    increment_build_number(
      xcodeproj: APP_PROJECT,
      build_number: latest_build_number + 1
    )
  end

  desc "Manage certificates and profiles"
  lane :code_signing do |options|
    match(
      type: options[:type] || "appstore",
      readonly: is_ci
    )
  end

  desc "CI entry point for pull requests"
  lane :ci do
    # Just build for simulator to verify it compiles (no code signing needed for simulator)
    xcodebuild(
      project: APP_PROJECT,
      scheme: APP_SCHEME,
      sdk: "iphonesimulator",
      destination: "generic/platform=iOS Simulator",
      configuration: "Debug",
      clean: true
    )
  end

  desc "Build and upload a new beta to TestFlight"
  lane :beta do
    load_asc_api_key
    code_signing(type: "appstore")
    fetch_and_increment_build_number

    build_app(
      project: APP_PROJECT,
      scheme: APP_SCHEME,
      export_method: EXPORT_METHOD,
      output_directory: "fastlane/build"
    )

    upload_to_testflight(skip_app_version_update: true)
  end

  desc "Release a build to the App Store"
  lane :release do
    load_asc_api_key
    code_signing(type: "appstore")
    fetch_and_increment_build_number

    build_app(
      project: APP_PROJECT,
      scheme: APP_SCHEME,
      export_method: EXPORT_METHOD,
      output_directory: "fastlane/build"
    )

    upload_to_app_store(
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: true
    )
  end
end
